---
import "@fontsource-variable/bricolage-grotesque/standard.css";
import "@fontsource/dm-mono/400.css";
import "@fontsource/dm-mono/500.css";
import "../styles/global.css";
import { festival, nav } from "../data/festival";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = festival.description } = Astro.props;
const fullTitle = title
  ? `${title} | ${festival.fullName} ${festival.edition}`
  : `${festival.fullName} ${festival.edition}: ${festival.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const year = festival.edition;
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f3eee3" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${festival.fullName} ${year}`} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label={`${festival.fullName}, home`}>
          <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
            <circle cx="16" cy="13" r="9" fill="#d39a12"></circle>
            <path d="M2 20c4-3 8-3 14 0s10 3 14 0v10H2z" fill="#2f5bd3" style="mix-blend-mode:multiply"></path>
          </svg>
          <span>{festival.name}</span>
          <span class="brand-year">{year}</span>
        </a>
        <nav aria-label="Main" class="desktop-nav">
          <ul>{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
        </nav>
        <a class="btn btn-primary cta" href="/#tickets">Buy tickets</a>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <nav aria-label="Main, mobile">
            <ul>
              {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
              <li><a class="btn btn-primary" href="/#tickets">Buy tickets</a></li>
            </ul>
          </nav>
        </details>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <p class="foot-name">{festival.fullName} {year}</p>
          <p class="meta">{festival.dates}. {festival.place}</p>
        </div>
        <ul class="foot-links">
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
        <ul class="foot-links">
          <li><a href={`mailto:${festival.contactEmail}`}>{festival.contactEmail}</a></li>
          {festival.social.map((s) => <li><a href={s.href} rel="noopener">{s.label}</a></li>)}
        </ul>
      </div>
    </footer>
    <script>
      document.querySelectorAll<HTMLAnchorElement>(".mobile-nav a").forEach((a) =>
        a.addEventListener("click", () => a.closest("details")?.removeAttribute("open")),
      );
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 1.1875rem;
    font-stretch: 85%;
    text-decoration: none;
    margin-right: auto;
  }
  .brand-year {
    font-family: var(--mono);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--ink-3);
  }
  .desktop-nav ul {
    display: flex;
    gap: 1.5rem;
  }
  .desktop-nav a {
    text-decoration: none;
    color: var(--ink-2);
    font-size: 0.9375rem;
    transition: color 160ms var(--ease);
  }
  .desktop-nav a:hover {
    color: var(--ink);
  }
  .cta {
    min-height: 36px;
    font-size: 0.9375rem;
  }
  .mobile-nav {
    display: none;
    position: relative;
  }
  .mobile-nav summary {
    list-style: none;
    cursor: pointer;
    font-weight: 500;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
  }
  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }
  .mobile-nav nav {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    width: min(80vw, 280px);
    background: var(--paper-card);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 8px;
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.08);
  }
  .mobile-nav li a:not(.btn) {
    display: block;
    padding: 0.625rem 0.75rem;
    text-decoration: none;
    border-radius: 6px;
  }
  .mobile-nav li a:not(.btn):hover {
    background: var(--paper-raised);
  }
  .mobile-nav .btn {
    width: 100%;
    margin-top: 8px;
  }
  @media (max-width: 960px) {
    .desktop-nav,
    .cta {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
  }
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 3rem;
  }
  .foot {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 2rem;
  }
  .foot-name {
    font-weight: 600;
    font-stretch: 85%;
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }
  .foot-links {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    font-size: 0.9375rem;
  }
  .foot-links a {
    color: var(--ink-2);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .foot-links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  @media (max-width: 720px) {
    .foot {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist.">
  <section class="section">
    <div class="wrap nf">
      <p class="meta">404</p>
      <h1>This path doesn't lead anywhere</h1>
      <p>The page may have moved, or the link has a typo.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/">Back to the festival</a>
        <a class="btn btn-secondary" href="/timetable/">See the timetable</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 1rem;
    max-width: 40rem;
    min-height: 50vh;
    align-content: center;
  }
  h1 {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-stretch: 80%;
    letter-spacing: -0.02em;
  }
  .nf > p:not(.meta) {
    color: var(--ink-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
</style>

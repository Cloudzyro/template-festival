---
import Base from "../layouts/Base.astro";
import Poster from "../components/Poster.astro";
import SiteMap from "../components/SiteMap.astro";
import SignupForm from "../components/SignupForm.astro";
import {
  artists,
  camping,
  days,
  faq,
  festival,
  newsletter,
  sets,
  sponsors,
  stages,
  ticketNotes,
  tickets,
  travel,
} from "../data/festival";
import { fmt, money, toMin } from "../lib/time";

const artist = (slug: string) => artists.find((a) => a.slug === slug)!;
const byStage = (day: string, stage: string) =>
  sets.filter((s) => s.day === day && s.stage === stage).sort((a, b) => toMin(a.start) - toMin(b.start));
const ticketUrl = festival.ticketUrl;
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(travel.mapQuery)}`;
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="meta hero-meta">{festival.dates} <span aria-hidden="true">/</span> {festival.place}</p>
        <h1>{festival.tagline}</h1>
        <p class="lede">
          Twenty-four acts on three stages, a beach with lifeguards, an art trail through the pines and two camping
          fields. Kettle Lake runs Friday to Sunday, with the campsite open from Thursday night.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="#tickets">Buy tickets</a>
          <a class="btn btn-secondary" href="/timetable/">See the timetable</a>
        </div>
      </div>
      <div class="hero-poster">
        <Poster />
      </div>
    </div>
  </section>

  <section id="lineup" class="section lineup" aria-labelledby="lineup-title">
    <div class="wrap">
      <div class="lineup-head">
        <div class="section-head">
          <h2 id="lineup-title">Lineup</h2>
          <p>Every act by day and stage. Tap through to the timetable to plan your weekend.</p>
        </div>
        <div class="tabs" role="tablist" aria-label="Festival day" hidden data-tabs>
          {
            days.map((d, i) => (
              <button role="tab" aria-selected={i === 0 ? "true" : "false"} aria-controls={`day-${d.id}`} id={`tab-${d.id}`} data-day={d.id}>
                {d.label}
                <span class="meta">{d.date.replace("July ", "Jul ")}</span>
              </button>
            ))
          }
        </div>
      </div>
      {
        days.map((d) => (
          <div class="day-panel" id={`day-${d.id}`} role="tabpanel" aria-labelledby={`tab-${d.id}`} data-panel={d.id}>
            <h3 class="day-title">
              {d.label}, {d.date} <span class="meta">{d.gates}</span>
            </h3>
            <div class="stage-cols">
              {stages.map((st) => (
                <div class="stage-col" style={`--c:${st.color}`}>
                  <p class="stage-name">
                    <span class="dot" />
                    {st.name}
                  </p>
                  <ol class="acts">
                    {byStage(d.id, st.id)
                      .slice()
                      .reverse()
                      .map((s) => (
                        <li>
                          <span class="act-name">{artist(s.artist).name}</span>
                          <span class="meta">
                            {fmt(s.start)}, {artist(s.artist).genre}
                          </span>
                        </li>
                      ))}
                  </ol>
                </div>
              ))}
            </div>
          </div>
        ))
      }
      <a class="btn btn-secondary" href="/timetable/">Open the full timetable</a>
    </div>
  </section>

  <section id="tickets" class="section tickets" aria-labelledby="tickets-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="tickets-title">Tickets</h2>
        <p>{ticketNotes}</p>
      </div>
      <ul class="stubs">
        {
          tickets.map((t) => (
            <li class:list={["stub", { featured: t.featured }]}>
              <div class="stub-main">
                <h3>{t.name}</h3>
                <p class="meta">{t.note}</p>
                <ul class="features">
                  {t.features.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>
              </div>
              <div class="stub-side">
                <p class="price">{money(t.price)}</p>
                <a class:list={["btn", t.featured ? "btn-primary" : "btn-secondary"]} href={ticketUrl} rel="noopener">
                  {t.price === 0 ? "Book" : "Buy"}
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="travel" class="section travel" aria-labelledby="travel-title">
    <div class="wrap travel-grid">
      <div>
        <div class="section-head">
          <h2 id="travel-title">Getting there</h2>
          <p>{travel.address}</p>
        </div>
        <dl class="ways">
          {
            travel.ways.map((w) => (
              <div>
                <dt>{w.title}</dt>
                <dd>{w.text}</dd>
              </div>
            ))
          }
        </dl>
        <a class="btn btn-secondary" href={mapUrl} rel="noopener">Open in maps</a>
      </div>
      <div class="map-wrap">
        <SiteMap />
        <p class="meta legend">
          {stages.map((s) => <span style={`--c:${s.color}`}><span class="dot" /> {s.name}</span>)}
        </p>
      </div>
    </div>
  </section>

  <section id="camping" class="section camping" aria-labelledby="camping-title">
    <div class="wrap camping-grid">
      <div class="section-head">
        <h2 id="camping-title">{camping.title}</h2>
        <p>{camping.text}</p>
      </div>
      <dl class="points">
        {
          camping.points.map((p) => (
            <div>
              <dt>{p.title}</dt>
              <dd>{p.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="faq" class="section faq" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <div class="section-head">
        <h2 id="faq-title">Questions</h2>
        <p>Anything else, email <a href={`mailto:${festival.contactEmail}`}>{festival.contactEmail}</a>.</p>
      </div>
      <div class="qs">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sponsors" aria-labelledby="sponsors-title">
    <div class="wrap">
      <h2 id="sponsors-title" class="meta sponsors-title">Made possible by</h2>
      <ul class="sponsor-list">
        {
          sponsors.map((s) => (
            <li>{s.logo ? <img src={s.logo} alt={s.name} height="32" /> : <span>{s.name}</span>}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section news" aria-labelledby="news-title">
    <div class="wrap news-grid">
      <div class="section-head">
        <h2 id="news-title">{newsletter.title}</h2>
        <p>{newsletter.text}</p>
      </div>
      <SignupForm />
    </div>
  </section>
</Base>

<script>
  const tabs = document.querySelector<HTMLElement>("[data-tabs]");
  if (tabs) {
    tabs.hidden = false;
    const buttons = [...tabs.querySelectorAll<HTMLButtonElement>("button")];
    const panels = [...document.querySelectorAll<HTMLElement>("[data-panel]")];
    const show = (day: string) => {
      buttons.forEach((b) => b.setAttribute("aria-selected", String(b.dataset.day === day)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== day));
    };
    buttons.forEach((b, i) => {
      b.addEventListener("click", () => show(b.dataset.day!));
      b.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        const next = buttons[(i + step + buttons.length) % buttons.length];
        next.focus();
        show(next.dataset.day!);
      });
    });
    show(buttons[0].dataset.day!);
  }
</script>

<style>
  .hero {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 8vw, 6rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .hero-meta {
    margin-bottom: 1.5rem;
    color: var(--red-ink);
  }
  .hero-meta span {
    color: var(--ink-3);
    margin-inline: 0.25rem;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.03em;
    line-height: 1;
    font-stretch: 85%;
    max-width: 13ch;
  }
  .lede {
    margin-top: 1.5rem;
    font-size: 1.1875rem;
    color: var(--ink-2);
    max-width: 34rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero-poster {
    max-width: 430px;
    justify-self: end;
    width: 100%;
  }

  .lineup {
    border-top: 1px solid var(--line);
  }
  .lineup-head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .lineup-head .section-head {
    margin-bottom: 0;
  }
  .day-panel {
    margin-bottom: 2.5rem;
  }
  .day-title {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    font-size: 1.125rem;
  }
  .stage-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line-strong);
  }
  .stage-col {
    padding: 1.25rem 1.5rem 1.5rem 0;
  }
  .stage-col + .stage-col {
    border-left: 1px solid var(--line);
    padding-left: 1.5rem;
  }
  .stage-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--ink-2);
    margin-bottom: 1rem;
  }
  .acts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.875rem;
  }
  .acts li {
    display: grid;
    gap: 2px;
  }
  .act-name {
    font-size: 1.25rem;
    font-weight: 500;
    font-stretch: 85%;
    line-height: 1.15;
  }
  .acts li:first-child .act-name {
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .tickets {
    background: var(--paper-raised);
  }
  .stubs {
    display: grid;
    gap: 12px;
  }
  .stub {
    display: grid;
    grid-template-columns: 1fr 220px;
    background: var(--paper-card);
    border-radius: 12px;
    border: 1px solid var(--line);
  }
  .stub-main {
    padding: 24px;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 4px 24px;
    align-items: start;
  }
  .stub-main h3 {
    font-size: 1.5rem;
    font-stretch: 85%;
  }
  .stub-main .meta {
    grid-column: 1;
  }
  .features {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  .stub-side {
    padding: 20px 24px;
    border-left: 2px dashed var(--line-strong);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .price {
    font-size: 1.75rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .stub.featured {
    border-color: var(--red);
    box-shadow: inset 4px 0 0 var(--red);
  }

  .travel-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .travel-grid .section-head {
    margin-bottom: 2rem;
  }
  .ways,
  .points {
    margin: 0 0 2rem;
    display: grid;
    gap: 1.25rem;
  }
  dt {
    font-weight: 500;
    margin-bottom: 2px;
  }
  dd {
    margin: 0;
    color: var(--ink-2);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
  }
  .legend > span {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .camping {
    border-top: 1px solid var(--line);
  }
  .camping-grid,
  .faq-grid,
  .news-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .points {
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
    margin: 0;
  }
  .points > div {
    border-top: 1px solid var(--line-strong);
    padding-top: 0.875rem;
  }

  .faq {
    border-top: 1px solid var(--line);
  }
  .faq a {
    color: var(--red-ink);
  }
  .qs details {
    border-bottom: 1px solid var(--line-strong);
  }
  .qs details:first-child {
    border-top: 1px solid var(--line-strong);
  }
  .qs summary {
    cursor: pointer;
    list-style: none;
    padding: 1rem 2rem 1rem 0;
    font-weight: 500;
    font-size: 1.125rem;
    position: relative;
  }
  .qs summary::-webkit-details-marker {
    display: none;
  }
  .qs summary::after {
    content: "+";
    position: absolute;
    right: 0.25rem;
    top: 0.875rem;
    font-family: var(--mono);
    color: var(--ink-3);
  }
  .qs details[open] summary::after {
    content: "\2212";
  }
  .qs details p {
    padding-bottom: 1.25rem;
    color: var(--ink-2);
    max-width: 40rem;
  }

  .sponsors {
    border-top: 1px solid var(--line);
    padding-block: 3rem;
  }
  .sponsors-title {
    font-size: 0.8125rem;
    margin-bottom: 1.25rem;
  }
  .sponsor-list {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    font-size: 1.375rem;
    font-weight: 500;
    font-stretch: 78%;
    color: var(--ink-2);
  }

  .news {
    background: var(--ink);
    color: var(--paper);
  }
  .news .section-head p {
    color: #c6c2b8;
  }
  .news :global(.field) {
    color: #c6c2b8;
  }
  .news :global(.btn-primary) {
    background: var(--paper);
    color: var(--ink);
  }
  .news :global(.btn-primary:hover) {
    background: #fff;
  }
  .news :global(.note),
  .news :global(.status) {
    color: #b0ada5;
  }
  .news :global(:focus-visible) {
    outline-color: var(--paper);
  }

  @media (max-width: 960px) {
    .hero-grid,
    .travel-grid,
    .camping-grid,
    .faq-grid,
    .news-grid {
      grid-template-columns: 1fr;
    }
    .hero-poster {
      justify-self: center;
    }
    .stub,
    .stub-main {
      grid-template-columns: 1fr;
    }
    .features {
      grid-column: 1;
      grid-row: auto;
      margin-top: 0.75rem;
    }
    .stub-side {
      border-left: 0;
      border-top: 2px dashed var(--line-strong);
    }
  }
  @media (max-width: 720px) {
    .stage-cols {
      grid-template-columns: 1fr;
    }
    .stage-col,
    .stage-col + .stage-col {
      padding: 1.25rem 0;
      border-left: 0;
    }
    .stage-col + .stage-col {
      border-top: 1px solid var(--line);
    }
    .points {
      grid-template-columns: 1fr;
    }
  }
</style>

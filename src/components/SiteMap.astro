---
// A drawn map of the festival grounds. Edit the labels here if your site differs.
import { stages } from "../data/festival";

const c = Object.fromEntries(stages.map((s) => [s.id, s.color]));
---

<svg class="sitemap" viewBox="0 0 560 400" role="img" aria-labelledby="map-title map-desc">
  <title id="map-title">Map of the festival grounds</title>
  <desc id="map-desc">
    The lake runs along the top. The Boathouse sits on the shore next to the beach. The Meadow Stage is in the
    middle of the field, the Pines Tent in the trees to the east. Camping is in the Birch and Pine fields to the
    south, with the main gate and parking off Lakeshore Road at the bottom.
  </desc>
  <rect width="560" height="400" fill="#efe8d8"></rect>
  <path d="M0 0 H560 V70 C480 92 420 64 340 84 S200 104 120 80 S30 70 0 86Z" fill="#c9d6ee"></path>
  <path d="M40 40 C90 34 130 46 180 40" stroke="#fff" stroke-width="2" fill="none" opacity="0.7"></path>
  <path d="M300 30 C350 24 390 36 440 30" stroke="#fff" stroke-width="2" fill="none" opacity="0.7"></path>
  <path d="M150 92 C190 104 240 104 280 94 L284 110 C240 122 190 122 148 110Z" fill="#e8d6a8"></path>
  <g fill="#cbd5b4">
    <circle cx="430" cy="150" r="16"></circle><circle cx="456" cy="166" r="14"></circle><circle cx="478" cy="142" r="15"></circle>
    <circle cx="500" cy="172" r="13"></circle><circle cx="446" cy="192" r="15"></circle><circle cx="472" cy="206" r="13"></circle>
    <circle cx="96" cy="260" r="13"></circle><circle cx="120" cy="276" r="12"></circle><circle cx="80" cy="290" r="12"></circle>
  </g>
  <path d="M280 380 V320 C280 290 260 270 230 250" stroke="#fbf8f1" stroke-width="10" fill="none" stroke-linecap="round"></path>
  <path d="M280 320 C320 300 380 260 440 230" stroke="#fbf8f1" stroke-width="8" fill="none" stroke-linecap="round"></path>
  <path d="M230 250 C220 200 220 150 230 118" stroke="#fbf8f1" stroke-width="8" fill="none" stroke-linecap="round"></path>
  <rect x="0" y="372" width="560" height="28" fill="#d9d0bd"></rect>

  <g font-family="DM Mono, ui-monospace, monospace" font-size="12" fill="#1b1f2a">
    <rect x="232" y="84" width="40" height="22" rx="3" fill={c.boathouse}></rect>
    <text x="290" y="100">Boathouse</text>
    <text x="164" y="130" fill="#474c58">Beach</text>

    <path d="M196 200 h64 l-8 -26 h-48z" fill={c.meadow}></path>
    <text x="196" y="220">Meadow Stage</text>

    <rect x="408" y="236" width="52" height="30" rx="15" fill={c.pines}></rect>
    <text x="472" y="256">Pines Tent</text>

    <rect x="40" y="300" width="150" height="56" rx="4" fill="none" stroke="#1b1f2a" stroke-dasharray="4 4"></rect>
    <text x="52" y="332">Birch field camping</text>
    <rect x="360" y="300" width="160" height="56" rx="4" fill="none" stroke="#1b1f2a" stroke-dasharray="4 4"></rect>
    <text x="372" y="332">Pine field camping</text>

    <rect x="266" y="352" width="28" height="18" rx="2" fill="#1b1f2a"></rect>
    <text x="300" y="366">Main gate</text>
    <text x="16" y="390" fill="#474c58">Lakeshore Road</text>
    <text x="440" y="390" fill="#474c58">Parking</text>
    <text x="24" y="28" fill="#2f4b8a">Kettle Lake</text>
  </g>
</svg>

<style>
  .sitemap {
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--line);
  }
</style>
